# ─────────────────────────────────────────────────────────────────────────────
# SETUP: Copy this file to .env and fill in your Supabase credentials.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# The server will crash on startup if SUPABASE_URL or SUPABASE_SERVICE_KEY
# are missing or empty.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (Express)
PORT=5000

# Supabase — get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT secret for admin session tokens — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# ── UNUSED — legacy from SQLite implementation ────────────────────────────────
# SUPABASE_ANON_KEY=your-anon-key        (server only uses SERVICE_KEY)
# DATABASE_PATH=./database/library.db    (no longer SQLite — using Supabase)
# KIOSK_IDLE_TIMEOUT=180000              (hardcoded in React component)
# KIOSK_AUTO_RESET=4000                  (hardcoded in React component)
# ADMIN_DEFAULT_USERNAME=admin           (no seeding logic reads this)
# ADMIN_DEFAULT_PASSWORD=admin123        (no seeding logic reads this)
